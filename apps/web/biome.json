{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!.next", "!node_modules", "!coverage", "!next-env.d.ts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": { "preset": "none" }
    }
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always" }
  }
}
