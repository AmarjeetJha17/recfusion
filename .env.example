RECFUSION_ENVIRONMENT=development
RECFUSION_APP_NAME=RecFusion API
RECFUSION_DEBUG=false
RECFUSION_LOG_LEVEL=INFO

# Local Docker Compose PostgreSQL credentials.
# Copy this file to .env and set a unique password before starting services.
POSTGRES_USER=recfusion_local
POSTGRES_PASSWORD=
POSTGRES_DB=recfusion_local

# Host port 5432 is already used by a local PostgreSQL service on this machine.
POSTGRES_PORT=5433
